{
  "name": "@eventhub/api-gateway",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenv run -f .env -- nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:reset": "dotenv run -f .env -- prisma migrate reset --force && dotenv run -f .env -- prisma db seed"
  },
  "dependencies": {
    "@eventhub/contracts": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.5",
    "google-auth-library": "^11.3.2",
    "nestjs-pino": "^5.2.1",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "dotenv-cli": "^11.1.0",
    "eslint": "^10.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
